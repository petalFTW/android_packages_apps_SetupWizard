android_app {
    name: "LineageSetupWizard",

    srcs: ["src/**/*.java"],

    certificate: "platform",
    privileged: true,
    privapp_allowlist: "org.lineageos.setupwizard.xml",
    system_ext_specific: true,
    platform_apis: true,

    overrides: ["Provision"],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },

    static_libs: [
        "androidx.activity_activity",
        "SettingsLib",
        "setupcompat",
        "setupdesign",
        "SystemUISharedLib",
        "org.lineageos.platform.internal",
    ],

    libs: ["telephony-common"],
}

android_test {
    name: "PetalBackupAvailabilityTests",
    srcs: [
        "src/org/lineageos/setupwizard/backup/PetalBackupRestore.java",
        "tests/src/**/*.java",
    ],
    // android_test defaults to the package's res/ directory; these checks need
    // no resources and must not inherit the wizard's setupdesign theme deps.
    resource_dirs: [],
    manifest: "tests/AndroidManifest.xml",
    platform_apis: true,
    min_sdk_version: "35",
    libs: ["android.test.mock.stubs.system"],
    certificate: "platform",
    test_suites: ["device-tests"],
}
