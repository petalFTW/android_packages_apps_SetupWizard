    <dimen name="petal_app_icon">40dp</dimen>
    <dimen name="petal_step_mark_height">30dp</dimen>
    <declare-styleable name="PetalBloomView">
        <attr name="petalSpread" format="float" />
        <attr name="petalReach" format="float" />
    </declare-styleable>
    <string name="petal_wizard_script_uri" translatable="false">android.resource://org.lineageos.setupwizard/raw/petal_wizard_script</string>
    <string name="petal_welcome_title">Welcome to petalOS.</string>
    <string name="petal_welcome_line">Your phone, the way it should have shipped.</string>
    <string name="petal_welcome_steps">Seven quick steps: language, connection, privacy and apps. Then it’s yours.</string>
    <string name="petal_get_started">Get started</string>
    <string name="petal_wordmark" translatable="false">petalOS</string>
    <string name="petal_back">Back</string>
    <string name="petal_step_of">Step %1$d of %2$d</string>
    <string name="petal_ready">Theme, gestures and everything else are in Settings whenever you want them.</string>
    <string name="petal_welcome_home">Off you go.</string>
    <string name="petal_finish">Go to home screen</string>
    <string name="petal_finish_microg">When you’re ready for microG, the official downloads are linked in petalOS Hub, under Google Play and microG.</string>
    <string name="petal_continue_without">Continue without it</string>
    <string name="petal_services_title">Google services</string>
    <string name="petal_services_summary">petalOS doesn’t come with Google built in. Choose how apps that expect Google should work. You can change this later in petalOS Hub.</string>
    <string name="petal_services_google">Google Play</string>
    <string name="petal_services_google_summary">Install the Play Store and Play services bundled with petalOS. They run as ordinary, sandboxed apps.</string>
    <string name="petal_services_microg">microG</string>
    <string name="petal_services_microg_summary">A lighter, open-source alternative. You’ll pick which version next.</string>
    <string name="petal_services_microg_official_picked">Official microG. Install nothing now, download it yourself later.</string>
    <string name="petal_services_microg_petal_picked">petal microG. Installed now, with RCS and Wallet support.</string>
    <string name="petal_microg_flavor_title">Which microG?</string>
    <string name="petal_microg_official">Official microG</string>
    <string name="petal_microg_official_summary">Straight from the microG project and updated often. You download and install it yourself later.</string>
    <string name="petal_microg_petal">petal microG</string>
    <string name="petal_microg_petal_summary">Our build, signed for petalOS, with RCS chats in Google Messages and Wallet support. Installed now, updated less often.</string>
    <string name="petal_microg_pick">Use this</string>
    <string name="petal_services_installing_microg">Installing petal microG. This can take a minute.</string>
    <string name="petal_services_failed_microg">petal microG didn’t install. You can carry on and try again later in petalOS Hub.</string>
    <string name="petal_services_installing">Installing Google Play. This can take a minute or two.</string>
    <string name="petal_services_failed">Google Play didn’t install. You can carry on and try again later in petalOS Hub.</string>
    <string name="petal_apps_title">App Center</string>
    <string name="petal_apps_summary">Optional petalOS apps. Tick any you want now, or add them later in petalOS Hub.\n\nAll of these apps are in a very early alpha stage of development. Expect bugs, including in their core features.</string>
    <string name="petal_apps_install">Install and continue</string>
    <string name="petal_apps_installing">Installing your apps. This can take a minute.</string>
    <string name="petal_apps_failed">Those apps didn’t install. You can carry on and add them later in petalOS Hub.</string>
    <string name="petal_app_assistant_title">Petal Assistant</string>
    <string name="petal_app_tuner_title">PetalTuner</string>
    <string name="petal_app_idhelper_title">petal IDHelper</string>
    <string name="petal_app_assistant">A voice and text assistant whose language model runs on the phone.</string>
    <string name="petal_app_tuner">Bypass charging, charge limits, thermal limits and a distraction-free game mode.</string>
    <string name="petal_app_idhelper">Local avatar preview and privacy-camera controls.</string>

    <style name="Theme.Setup.Petal" parent="Theme.Setup">
        <item name="sucUsePartnerResource">false</item>
        <item name="sudUsePartnerHeavyTheme">false</item>
        <item name="android:windowBackground">@color/petal_setup_surface</item>
        <item name="android:colorBackground">@color/petal_setup_surface</item>
        <item name="android:colorPrimary">@color/petal_setup_accent</item>
        <item name="colorPrimary">@color/petal_setup_accent</item>
        <item name="android:colorAccent">@color/petal_setup_accent</item>
        <item name="colorAccent">@color/petal_setup_accent</item>
        <item name="android:colorControlActivated">@color/petal_setup_accent</item>
        <item name="android:textColorPrimary">@color/petal_setup_text</item>
        <item name="android:textColorSecondary">@color/petal_setup_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/petal_setup_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/petal_setup_light_bars</item>
        <item name="android:fontFamily">@font/petal_sans</item>
        <item name="fontFamily">@font/petal_sans</item>
    </style>

    <style name="PetalPrimaryButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/petal_button_primary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/petal_button_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">52dp</item>
    </style>
    <style name="PetalSecondaryButton" parent="PetalPrimaryButton">
        <item name="android:background">@drawable/petal_button_secondary</item>
        <item name="android:textColor">@color/petal_setup_text</item>
    </style>
    <style name="PetalTextButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">@color/petal_setup_text</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
    </style>
    <!-- The indicator is a drawable so it takes the row's padding like the text does. -->
    <style name="PetalChoiceRow">
        <item name="android:background">@drawable/petal_choice_row</item>
        <item name="android:button">@null</item>
        <item name="android:drawableStart">?android:attr/listChoiceIndicatorSingle</item>
        <item name="android:drawableTint">@color/petal_setup_accent</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineHeight">21sp</item>
        <item name="android:textColor">@color/petal_setup_text</item>
    </style>
    <style name="PetalCheckRow" parent="PetalChoiceRow">
        <item name="android:drawableStart">?android:attr/listChoiceIndicatorMultiple</item>
    </style>
    <style name="PetalHeroTitle">
        <item name="android:textSize">40sp</item>
        <item name="android:textFontWeight">800</item>
        <item name="android:lineHeight">46sp</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:textColor">@color/petal_setup_text</item>
    </style>
    <style name="PetalHeroLine">
        <item name="android:textSize">18sp</item>
        <item name="android:lineHeight">26sp</item>
        <item name="android:textColor">@color/petal_setup_text</item>
    </style>
    <style name="PetalHeroNote">
        <item name="android:textSize">15sp</item>
        <item name="android:lineHeight">22sp</item>
        <item name="android:textColor">@color/petal_setup_secondary</item>
    </style>
</resources>
