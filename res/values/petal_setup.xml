    <bool name="config_use_petal_setup">true</bool>
    <bool name="petal_setup_light_bars">true</bool>
    <color name="petal_setup_surface">#F6F6FA</color>
    <color name="petal_setup_text">#171921</color>
    <color name="petal_setup_secondary">#646A79</color>
    <color name="petal_setup_muted_surface">#FCFCFF</color>
    <color name="petal_setup_outline">#1F171921</color>
    <color name="petal_setup_accent">#6844D6</color>
    <color name="petal_setup_accent_container">#ECE7FF</color>
    <color name="petal_setup_on_accent">#FFFFFF</color>
    <color name="petal_setup_disabled">#1F171921</color>
    <color name="petal_setup_on_disabled">#646A79</color>
    <color name="petal_setup_ripple">#336844D6</color>
    <color name="petal_bloom_line">#6938EF</color>
    <color name="petal_step_top">#B79BFF</color>
    <color name="petal_step_bottom">#6844D6</color>
    <color name="petal_step_todo">#66646A79</color>
