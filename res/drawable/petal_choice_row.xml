<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/petal_setup_ripple">
    <item>
        <selector>
            <item android:state_checked="true">
                <shape>
                    <solid android:color="@color/petal_setup_accent_container" />
                    <stroke android:width="2dp" android:color="@color/petal_setup_accent" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/petal_setup_muted_surface" />
                    <stroke android:width="1dp" android:color="@color/petal_setup_outline" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
