<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/petal_setup_surface">
    <org.lineageos.setupwizard.widget.PetalBloomView android:id="@+id/petal_finish_bloom"
        android:layout_width="match_parent"
        android:layout_height="match_parent" app:petalSpread="1" app:petalReach="0.6" />
    <LinearLayout android:id="@id/linear_layout" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical"
        android:paddingHorizontal="40dp">
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingTop="64dp">
                <TextView style="@style/PetalHeroTitle" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/petal_welcome_home"
                    android:accessibilityHeading="true" />
                <TextView style="@style/PetalHeroLine" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:text="@string/petal_ready" />
                <TextView android:id="@+id/petal_finish_hint" style="@style/PetalHeroNote"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/petal_finish_microg"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
        <org.lineageos.setupwizard.NavigationLayout android:id="@id/navigation_bar"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>
