<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/petal_welcome_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@color/petal_setup_surface">
    <org.lineageos.setupwizard.widget.PetalBloomView android:layout_width="match_parent"
        android:layout_height="match_parent" app:petalSpread="0.62" app:petalReach="0.56" />
    <LinearLayout android:id="@+id/petal_welcome_content" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical"
        android:paddingHorizontal="40dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <include layout="@layout/petal_wordmark" />
            <Button android:id="@id/launch_accessibility" style="@style/PetalTextButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp"
                android:layout_marginEnd="-12dp" android:gravity="end|center_vertical"
                android:text="@string/accessibility_settings" />
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingTop="40dp" android:paddingBottom="24dp">
                <TextView android:id="@id/welcome_title" style="@style/PetalHeroTitle"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/petal_welcome_title" android:accessibilityHeading="true" />
                <TextView style="@style/PetalHeroLine" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:text="@string/petal_welcome_line" />
                <TextView android:id="@+id/petal_welcome_steps" style="@style/PetalHeroNote"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/petal_welcome_steps" />
            </LinearLayout>
        </ScrollView>
        <Button android:id="@id/skip" style="@style/PetalTextButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/skip" android:visibility="gone" />
        <Button android:id="@id/emerg_dialer" style="@style/PetalSecondaryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/emergency_call" />
        <Button android:id="@id/start" style="@style/PetalPrimaryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:layout_marginBottom="16dp"
            android:text="@string/petal_get_started" />
    </LinearLayout>
</FrameLayout>
